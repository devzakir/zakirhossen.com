      posthog.init('phc_ry6DpTrB6Ujq9FrcdW7kas6FaXFVp2DGy96Fr7CEKknF', {
        api_host: 'https://us.i.posthog.com',
        defaults: '2026-05-30',
        person_profiles: 'identified_only',
        // No surveys run on this site. Left on, PostHog pulls a further 34 KB
        // of surveys.js and executes it on every page load for nothing.
        disable_surveys: true,
      });
    </script>
  </body>
</html>
