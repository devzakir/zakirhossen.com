---
import '../styles/global.css';
import { content } from '../data/content';
import ThemeToggle from '../components/ThemeToggle.astro';
import Nav from '../components/Nav.astro';

const { meta, identity } = content;

interface Props {
  title?: string;
  description?: string;
  /** Site-root-relative path, e.g. "/now". Drives canonical + og:url. */
  path?: string;
  /** Extra JSON-LD nodes for this page, appended to the shared @graph. */
  schema?: Record<string, unknown>[];
  /** Keep the page out of the index (404 and other non-canonical routes). */
  noindex?: boolean;
}

const {
  title = meta.title,
  description = meta.description,
  path = '/',
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(path, meta.url).href;
const ogImage = new URL(meta.ogImage, meta.url).href;

const PERSON_ID = `${meta.url}/#person`;
const ORG_ID = 'https://lomeyo.com/#organization';
const SITE_ID = `${meta.url}/#website`;

// One @graph for the whole site: the Person is the entity we want search
// engines and LLMs to resolve, and every page points back at the same @id so
// they accumulate into one identity instead of N disconnected pages.
const graph = [
  {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: identity.name,
    alternateName: identity.handle,
    url: meta.url,
    image: new URL('/zakir.jpg', meta.url).href,
    jobTitle: identity.jobTitle,
    description: meta.description,
    email: `mailto:${content.footer.email}`,
    birthPlace: { '@type': 'Place', name: identity.birthPlace },
    nationality: { '@type': 'Country', name: identity.country },
    knowsLanguage: [
      { '@type': 'Language', name: 'Bengali' },
      { '@type': 'Language', name: 'English' },
    ],
    knowsAbout: identity.knowsAbout,
    worksFor: { '@id': ORG_ID },
    sameAs: identity.sameAs,
  },
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: 'Lomeyo, LLC',
    url: 'https://lomeyo.com',
    founder: { '@id': PERSON_ID },
    employee: { '@id': PERSON_ID },
  },
  {
    '@type': 'WebSite',
    '@id': SITE_ID,
    url: meta.url,
    name: identity.name,
    description: meta.description,
    inLanguage: 'en',
    publisher: { '@id': PERSON_ID },
  },
  ...schema,
];

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${identity.name} — solo founder building software in the open`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@devzakir" />
    <meta name="twitter:creator" content="@devzakir" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- The Bangla face is preloaded on purpose. Left to layout to discover it,
         Chrome requests it at VeryHigh priority, which is the one priority
         Lighthouse's model treats as render-blocking — that put the font on the
         First Contentful Paint path and cost ~300 ms. A preload is fetched at
         High, which is never render-blocking, and it arrives before the Bangla
         captions are painted so there is no swap. It is 44 KB, down from 108. -->
    <link rel="preload" href="/fonts/noto-sans-bengali-400.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
    <ThemeToggle />
    <Nav />
    <slot />

    <!-- PostHog — product analytics + session replay for zakirhossen.com.
         Lives at the end of <body>, not in <head>: as a synchronous inline
         script in the head its 2.6 KB had to be parsed and run before the
         browser could reach any content, and it injected array.js on the way.
         Down here the stub still runs on the same page load, so init() and the
         pageview both fire exactly as before — just after the page has painted. -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}p||((p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",p.onerror=function(){p=null},(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r));var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="al ol ll init Il Rl Tl Ml Ol za El Dl Sl capture getExtension Pl nl Hl calculateEventProperties Bl register register_once register_for_session unregister unregister_for_session Vl Cl zl getFeatureFlag getFeatureFlagPayload getFeatureFlagResult getAllFeatureFlags isFeatureEnabled reloadFeatureFlags updateFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey displaySurvey cancelPendingSurvey canRenderSurvey canRenderSurveyAsync Gl identify setPersonProperties unsetPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset Zl shutdown setIdentity clearIdentity get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException addExceptionStep captureLog startExceptionAutocapture stopExceptionAutocapture loadToolbar get_property getSessionProperty Ul ql createPersonProfile setInternalOrTestUser Wl ul hl opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing get_explicit_consent