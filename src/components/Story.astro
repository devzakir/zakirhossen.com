---
import { content } from '../data/content';
const { story } = content;
---
<section class="mx-auto max-w-2xl px-6 py-16">
  <h2 class="mb-6 text-sm font-semibold uppercase tracking-wide text-neutral-500" lang="en">My story</h2>
  <p class="text-lg leading-relaxed text-neutral-700 dark:text-neutral-300" lang="en">{story.en}</p>
  <p class="mt-4 text-base text-neutral-500" lang="bn">{story.accentBn}</p>
</section>
