---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Fights from '../components/Fights.astro';
import Building from '../components/Building.astro';
import Story from '../components/Story.astro';
import Follow from '../components/Follow.astro';
import Footer from '../components/Footer.astro';
import { content } from '../data/content';

const { meta } = content;

// ProfilePage tells crawlers this URL *is* the person's home on the web —
// the canonical page for the Person entity the Layout declares.
const schema = [
  {
    '@type': 'ProfilePage',
    '@id': `${meta.url}/#page`,
    url: meta.url,
    name: meta.title,
    description: meta.description,
    mainEntity: { '@id': `${meta.url}/#person` },
    inLanguage: 'en',
  },
];
---
<Layout path="/" schema={schema}>
  <main>
    <Hero />
    <Fights />
    <Building />
    <Story />
    <Follow />
  </main>
  <Footer />
</Layout>
