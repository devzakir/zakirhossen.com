---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { content } from '../data/content';

const { now, meta } = content;
const PERSON_ID = `${meta.url}/#person`;

const updatedLabel = new Date(`${now.updated}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${meta.url}/now/#page`,
    url: `${meta.url}/now/`,
    name: now.heading,
    description: now.meta.description,
    about: { '@id': PERSON_ID },
    dateModified: now.updated,
    inLanguage: 'en',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: meta.url },
      { '@type': 'ListItem', position: 2, name: 'Now', item: `${meta.url}/now/` },
    ],
  },
];
---
<Layout title={now.meta.title} description={now.meta.description} path="/now/" schema={schema}>
  <main class="mx-auto max-w-2xl px-6 pt-14 pb-8">
    <h1 class="text-3xl font-bold sm:text-4xl" lang="en">{now.heading}</h1>
    <p class="mt-3 text-sm text-neutral-500" lang="en">
      Last updated <time datetime={now.updated}>{updatedLabel}</time>
    </p>
    <p class="mt-6 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300" lang="en">
      {now.intro}
    </p>

    <div class="mt-12 space-y-10">
      {now.sections.map((s) => (
        <section>
          <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-neutral-500" lang="en">{s.title}</h2>
          <ul class="space-y-4">
            {s.items.map((item) => (
              <li class="border-l-2 border-neutral-300 pl-4 leading-relaxed text-neutral-700 dark:border-neutral-700 dark:text-neutral-300" lang="en">{item}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="mt-10 text-base text-neutral-500" lang="bn">{now.accentBn}</p>

    <p class="mt-10 text-sm text-neutral-500" lang="en">
      This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener" class="text-accent underline-offset-2 hover:underline">now page</a>.
      The products themselves live on <a href="/projects/" class="text-accent underline-offset-2 hover:underline">projects</a>,
      and what I learn building them is in <a href="/writing/" class="text-accent underline-offset-2 hover:underline">writing</a>.
    </p>
  </main>
  <Footer />
</Layout>
